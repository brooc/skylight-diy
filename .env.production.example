# Copy this file to .env.production and replace every placeholder.
# Use localhost when Google accounts are managed from the server Mac.
APP_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
# Expose Daymark to the home LAN for Fully Kiosk Browser.
# Set to 127.0.0.1 to restrict the bootstrap port to this computer only.
DAYMARK_BIND_ADDRESS=0.0.0.0
# Public multi-architecture images. Use main for testing or a release tag for production.
DAYMARK_IMAGE_TAG=main
DAYMARK_INSTALLED_VERSION=manual
# Enables the admin update control on an appliance host.
# DAYMARK_UPDATE_DIR=/var/lib/daymark/update

# Optional private HTTPS integration. Leave off for a simple Fully/LAN deployment.
TAILSCALE_ENABLED=false

POSTGRES_PASSWORD=replace-with-a-random-hex-secret
DATABASE_URL=postgres://daymark:replace-with-the-same-random-hex-secret@postgres:5432/daymark
# Set this to an existing Daymark volume when migrating from development.
# DAYMARK_POSTGRES_VOLUME=skylight-diy_postgres_data

SESSION_COOKIE_NAME=daymark_session
SESSION_SECRET=replace-with-a-long-random-secret
# Generated automatically by the Raspberry Pi provisioner. It protects first-run setup.
DAYMARK_SETUP_TOKEN=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-output-from-openssl-rand-base64-32

# Add these when Google Calendar is configured. The redirect must exactly match Google Cloud.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback

CALENDAR_CACHE_FRESH_TTL_SECONDS=300
CALENDAR_CACHE_STALE_TTL_SECONDS=86400
